# Opcional en producción: URL del backend (sin / final). En local déjalo vacío y usa el proxy de Vite.
# VITE_API_URL=https://tu-api.example.com

# Si defines estas variables, el frontend iniciará sesión directo con Supabase Auth.
# Requiere que el login use email/password y que los roles estén en user_metadata (rol, isSuperuser, isStaff).
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...

# Bucket en Supabase Storage para adjuntos de seguimiento (ruta pública o políticas de lectura para usuarios autenticados).
# VITE_SUPABASE_DOCUMENTOS_BUCKET=documentos-notas

# Reset admin de contraseñas (modo híbrido):
# 1) Si defines endpoint, el front envía usuarioId/newPassword con Bearer del usuario admin actual.
#    Ese endpoint debe ejecutar en backend/Edge con service_role.
# VITE_SUPABASE_ADMIN_RESET_ENDPOINT=https://TU_PROJECT_REF.supabase.co/functions/v1/admin-reset-password
#
# 2) Si NO defines endpoint, se usa fallback: envío de correo resetPasswordForEmail al email del usuario.
# VITE_SUPABASE_RESET_REDIRECT_URL=https://tu-front.example.com/login
