# --- Modo recomendado: solo API + Postgres (p. ej. Supabase como host de BD) ---
# En local suele bastar vacío: Vite hace proxy a /api → http://127.0.0.1:3001
# En producción (Netlify, etc.): URL pública del servidor Node, sin barra final.
# VITE_API_URL=https://tu-api.example.com

# --- Opcional: cliente Supabase en el navegador (Auth + PostgREST directo) ---
# Por defecto está DESACTIVADO aunque definas VITE_SUPABASE_URL. Para volver al modo híbrido:
# VITE_USE_SUPABASE_CLIENT=true
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...
#
# Bucket Storage para adjuntos en modo Supabase directo:
# VITE_SUPABASE_DOCUMENTOS_BUCKET=documentos-notas
#
# Edge Functions (solo con modo Supabase en navegador):
# VITE_SUPABASE_ADMIN_RESET_ENDPOINT=...
# VITE_SUPABASE_ADMIN_SYNC_EMAIL_ENDPOINT=...
# VITE_SUPABASE_ADMIN_SYNC_METADATA_ENDPOINT=...
# VITE_SUPABASE_RESET_REDIRECT_URL=https://tu-front.example.com/login
