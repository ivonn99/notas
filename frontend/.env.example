# --- Supabase (obligatorio) + login db-login-jwt ---
# En Netlify: Site settings → Environment variables
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...
# VITE_SUPABASE_DB_LOGIN=true
#
# Edge: despliega `db-login-jwt`, `db-change-own-password` y las admin que uses.
# Secret JWT_SECRET en Edge = mismo valor que Settings → API → JWT Secret (legacy).
# Rate limit login (secrets opcionales en db-login-jwt): LOGIN_RATE_LIMIT_MAX=20, LOGIN_RATE_LIMIT_WINDOW_MS=900000
# VITE_SUPABASE_DB_LOGIN_ENDPOINT=  (opcional; por defecto VITE_SUPABASE_URL/functions/v1/db-login-jwt)
# VITE_SUPABASE_DB_CHANGE_PASSWORD_ENDPOINT=  (opcional; perfil → cambiar contraseña: db-change-own-password)
#
# Adjuntos en Storage (seguimiento):
# VITE_SUPABASE_DOCUMENTOS_BUCKET=documentos-notas
#
# Edge Functions (reset pass, sync email/metadata) si las usas:
# VITE_SUPABASE_ADMIN_RESET_ENDPOINT=...
# VITE_SUPABASE_ADMIN_SYNC_EMAIL_ENDPOINT=...
# VITE_SUPABASE_ADMIN_SYNC_METADATA_ENDPOINT=...
# VITE_SUPABASE_RESET_REDIRECT_URL=https://tu-dominio.netlify.app/login

# --- API Node (opcional: WhatsApp Baileys y lectura de app.log) ---
# URL pública del servidor donde corre `api/`, sin barra final.
# En local suele bastar vacío: proxy de Vite a /api → 127.0.0.1:3001
# VITE_API_URL=https://tu-api.example.com

# --- Enlaces imágenes (Cloudinary, subida desde el navegador) ---
# En Cloudinary: Settings → Upload → Upload presets → Add → Signing mode: Unsigned.
# Puedes fijar carpeta por defecto en el preset si lo necesitas.
# VITE_CLOUDINARY_CLOUD_NAME=tu_cloud_name
# VITE_CLOUDINARY_UPLOAD_PRESET=tu_preset_unsigned
#
# NO uses aquí CLOUDINARY_URL ni API Secret: cualquier VITE_* se incluye en el bundle público.
# CLOUDINARY_URL=cloudinary://... solo es para backend (Node), nunca para Vite/React.
