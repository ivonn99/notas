# PostgreSQL (recomendado para migrar a Supabase):
# SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.xxxxx.supabase.co:5432/postgres?sslmode=require
# Si usas Supabase, este valor tiene prioridad en el backend.
# Si el front no define VITE_SUPABASE_URL, usa este API (login /api/auth/login + cookie JWT).
# SUPABASE_DB_URL=

# Alternativa si ya usas este nombre en otro servicio:
# DATABASE_URL=

# Sincronizar tabla usuarios con Supabase Auth (script api/scripts/sync-usuarios-to-supabase-auth.mjs):
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ... (solo servidor; nunca en el frontend)

# Límite del body JSON (p. ej. lotes WhatsApp con mensajes largos). Por defecto en código: 15mb.
# JSON_BODY_LIMIT=15mb

# Puerto del API (opcional; por defecto 3001)
# PORT=3001

# Firma de JWT (cookies httpOnly). Mínimo ~16 caracteres; en producción usa un valor largo aleatorio.
# JWT_SECRET=
# JWT_EXPIRES_IN=7d

# En producción con HTTPS: COOKIE_SECURE=true (cookies solo por TLS)
# COOKIE_SECURE=

# Ruta opcional del log de aplicación (por defecto: api/logs/app.log). La pantalla "Logs" puede leerlo.
# APP_LOG_PATH=

# Baileys / WhatsApp (MVP)
# Modo de integración:
# - local: usa Baileys en este mismo API
# - remote: delega a un servicio externo (microservicio WhatsApp)
# - disabled: deshabilita envíos y conexión
# WHATSAPP_MODE=local
#
# URL base del microservicio (solo WHATSAPP_MODE=remote)
# Ejemplo: https://whatsapp-tuapp.onrender.com
# WHATSAPP_SERVICE_URL=
#
# Token opcional para autenticación entre servicios (header x-whatsapp-service-token)
# WHATSAPP_SERVICE_TOKEN=
#
# Timeout HTTP al microservicio remoto en ms (solo WHATSAPP_MODE=remote)
# WHATSAPP_REMOTE_TIMEOUT_MS=8000
#
# Carpeta para persistir sesión QR/auth. Si no se define, usa api/.baileys_auth
# WHATSAPP_SESSION_DIR=.baileys_auth
# Teléfono opcional para /api/whatsapp/send-test (solo dígitos o formato +52...)
# WHATSAPP_TEST_PHONE=
