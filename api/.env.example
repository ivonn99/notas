# PostgreSQL (recomendado para migrar a Supabase):
# SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.xxxxx.supabase.co:5432/postgres?sslmode=require
# Si usas Supabase, este valor tiene prioridad en el backend.
# Si el front no define VITE_SUPABASE_URL, usa este API (login /api/auth/login + cookie JWT).
# SUPABASE_DB_URL=

# Alternativa si ya usas este nombre en otro servicio:
# DATABASE_URL=

# Sincronizar tabla usuarios con Supabase Auth (script api/scripts/sync-usuarios-to-supabase-auth.mjs):
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ... (solo servidor; nunca en el frontend)

# Límite del body JSON (p. ej. lotes WhatsApp con mensajes largos). Por defecto en código: 15mb.
# JSON_BODY_LIMIT=15mb

# Puerto del API (opcional; por defecto 3001)
# PORT=3001

# Rutas legacy del API (Postgres directo, sin RLS). Desactivadas por defecto.
# El frontend usa Supabase; solo montar WhatsApp + logs-sistema + health.
# Activar solo durante migración o herramientas externas que aún llamen /api/notas-credito, etc.
# API_LEGACY_ROUTES=true
#
# Expone GET /api/db/ping (metadatos BD). Por defecto false; true automático si API_LEGACY_ROUTES=true.
# DB_PING_ENABLED=true

# CORS — orígenes del frontend que pueden llamar al API (WhatsApp, logs).
# En producción es obligatorio para Netlify u otro host distinto al API.
# Varios valores separados por coma. Comodín `*` en un segmento (p. ej. previews Netlify):
# CORS_ORIGINS=https://tu-app.netlify.app,https://*.netlify.app
# En local, si el front usa proxy Vite (/api → :3001), CORS no aplica; si VITE_API_URL apunta
# directo al API, incluye http://localhost:5173 o deja el default de desarrollo (localhost).
# CORS_ALLOW_LOCALHOST=false  (solo en dev; desactiva localhost si hace falta)

# Rate limit en POST /api/auth/login (intentos fallidos por IP).
# Por defecto: 20 fallos / 15 min. Los logins correctos no cuentan (skipSuccessfulRequests).
# AUTH_RATE_LIMIT_MAX=20
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_DISABLED=true   (solo pruebas locales; no usar en producción)
#
# Detrás de proxy (Render, Railway): confía en X-Forwarded-For para la IP real.
# En producción se activa trust proxy=1 por defecto; override:
# TRUST_PROXY=1

# Cabeceras HTTP de seguridad (helmet). Desactivar solo en depuración:
# HELMET_DISABLED=true

# Firma de JWT (cookies httpOnly). Mínimo ~16 caracteres; en producción usa un valor largo aleatorio.
# JWT_SECRET=
# JWT_EXPIRES_IN=7d

# En producción con HTTPS: COOKIE_SECURE=true (cookies solo por TLS)
# COOKIE_SECURE=

# Ruta opcional del log de aplicación (por defecto: api/logs/app.log). La pantalla "Logs" puede leerlo.
# APP_LOG_PATH=

# Baileys / WhatsApp (MVP)
# Modo de integración:
# - local: usa Baileys en este mismo API
# - remote: delega a un servicio externo (microservicio WhatsApp)
# - disabled: deshabilita envíos y conexión
# WHATSAPP_MODE=local
#
# URL base del microservicio (solo WHATSAPP_MODE=remote)
# Ejemplo: https://whatsapp-tuapp.onrender.com
# WHATSAPP_SERVICE_URL=
#
# Token opcional para autenticación entre servicios (header x-whatsapp-service-token)
# WHATSAPP_SERVICE_TOKEN=
#
# Timeout HTTP al microservicio remoto en ms (solo WHATSAPP_MODE=remote)
# WHATSAPP_REMOTE_TIMEOUT_MS=8000
#
# Carpeta para persistir sesión QR/auth. Si no se define, usa api/.baileys_auth
# WHATSAPP_SESSION_DIR=.baileys_auth
# Teléfono opcional para /api/whatsapp/send-test (solo dígitos o formato +52...)
# WHATSAPP_TEST_PHONE=
