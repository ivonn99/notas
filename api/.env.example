# Neon: panel del proyecto → Connection string → copiar URI de PostgreSQL.
# Formato típico: postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
NEON_DATABASE_URL=

# Alternativa si ya usas este nombre en otro servicio:
# DATABASE_URL=

# Puerto del API (opcional; por defecto 3001)
# PORT=3001

# Firma de JWT (cookies httpOnly). Mínimo ~16 caracteres; en producción usa un valor largo aleatorio.
# JWT_SECRET=
# JWT_EXPIRES_IN=7d

# En producción con HTTPS: COOKIE_SECURE=true (cookies solo por TLS)
# COOKIE_SECURE=

# Ruta opcional del log de aplicación (por defecto: api/logs/app.log). La pantalla "Logs" puede leerlo.
# APP_LOG_PATH=

# Baileys / WhatsApp (MVP)
# Carpeta para persistir sesión QR/auth. Si no se define, usa api/.baileys_auth
# WHATSAPP_SESSION_DIR=.baileys_auth
# Teléfono opcional para /api/whatsapp/send-test (solo dígitos o formato +52...)
# WHATSAPP_TEST_PHONE=
